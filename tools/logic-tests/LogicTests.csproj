<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>JevFiles.LogicTests</AssemblyName>
    <RootNamespace>Flow.Launcher.Plugin.JevFileSearch.Tests</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- The plugin itself is a WPF project and cannot build on Linux, so the pure logic
       files are compiled into this console runner to be exercised here and in CI. -->
  <ItemGroup>
    <Compile Include="../../Flow.Launcher.Plugin.JevFileSearch/*.cs"
             Exclude="../../Flow.Launcher.Plugin.JevFileSearch/Main.cs;../../Flow.Launcher.Plugin.JevFileSearch/SettingsControl.xaml.cs;../../Flow.Launcher.Plugin.JevFileSearch/obj/**;../../Flow.Launcher.Plugin.JevFileSearch/bin/**" />
  </ItemGroup>

</Project>
